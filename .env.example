# ==============================================================================
# Inv1s1bl3 Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or real secrets into source control!
# ==============================================================================

# Application Environment
# 'development' enables debug logs and developer features
# 'production' enables production safeguards and optimized logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Discord Bot Credentials
# ------------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Default prefix for traditional message commands
DEFAULT_PREFIX=i.

# Discord Application Client ID and Secret (Required for OAuth2 / Dashboard)
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Discord Bot Support Server Invite
SUPPORT_SERVER_URL=https://discord.gg/your_invite_code

# Optional Bot Owner User IDs (comma-separated integers)
OWNER_IDS=123456789012345678

# ------------------------------------------------------------------------------
# Database Configuration (SQLAlchemy 2.0 Async URL)
# ------------------------------------------------------------------------------
# Supported schemes:
#   SQLite (local zero-config): sqlite+aiosqlite:///data/bot.db
#   PostgreSQL:                postgresql+asyncpg://user:password@localhost:5432/bot_db
#   MySQL / MariaDB:           mysql+aiomysql://user:password@localhost:3306/bot_db
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ------------------------------------------------------------------------------
# Web Dashboard & OAuth2 Configuration
# ------------------------------------------------------------------------------
# Secret key for signing Flask sessions (generate a secure random string)
SECRET_KEY=generate_a_secure_random_flask_secret_key_here

# Dashboard HTTP server host and port
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8082

# Base URL of the dashboard where users will access it
DASHBOARD_BASE_URL=http://localhost:8082

# OAuth2 redirect URI configured in Discord Developer Portal
# Must exactly match what is registered in Discord application OAuth2 settings
DISCORD_REDIRECT_URI=http://localhost:8082/callback

# ------------------------------------------------------------------------------
# Optional External API Keys
# ------------------------------------------------------------------------------
# NASA APOD API key (Get a free key from https://api.nasa.gov/, or leave DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# GIPHY API key for GIF search (https://developers.giphy.com/)
GIPHY_API_KEY=

# OpenAI or compatible LLM key for AI chat feature (optional)
OPENAI_API_KEY=
